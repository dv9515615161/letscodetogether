# ---------------------------------------------------------------------------
# PriceFinder — example environment file
# Copy to `.env` (`cp .env.example .env`) and fill in.
# NEVER commit a real `.env`. No real keys belong in this file.
# ---------------------------------------------------------------------------

# --- Database (OPTIONAL for local dev) -------------------------------------
# The app runs fully without a database: search works, and caching falls back
# to an in-process memory store. A database adds persistence: search history,
# price history and a shared cache across serverless instances.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pricefinder?schema=public"

# --- Provider toggles ------------------------------------------------------
# Any provider can be switched off without touching code. Unset defaults to on.
ENABLE_BLINKIT=true
ENABLE_ZEPTO=true
ENABLE_AMAZON=true
ENABLE_FLIPKART=true
ENABLE_BIGBASKET=true
ENABLE_INSTAMART=true

# --- Live provider credentials (all OPTIONAL) ------------------------------
# Leave every value blank to run the provider in DEMO mode (clearly labelled
# "Demo data" in the UI and in the API response).
#
# A provider only flips to LIVE when its required variables below are present.
# See README > "Connecting live providers" for what each integration requires.

# Amazon — Product Advertising API v5 (requires an approved Associates account
# with qualifying sales). Docs: https://webservices.amazon.com/paapi5/documentation/
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

# Flipkart — Affiliate/Commerce API (requires an approved affiliate account).
# Docs: https://affiliate.flipkart.com/api-docs/hometml
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Blinkit / Zepto / BigBasket / Swiggy Instamart — no public product-search API
# is offered to third parties at the time of writing. These stay in demo mode
# until a partner/commerce agreement provides documented, authorised access.
# Fill in whatever the partner programme issues you.
BLINKIT_API_BASE_URL=
BLINKIT_API_KEY=
ZEPTO_API_BASE_URL=
ZEPTO_API_KEY=
BIGBASKET_API_BASE_URL=
BIGBASKET_API_KEY=
INSTAMART_API_BASE_URL=
INSTAMART_API_KEY=

# --- Tuning ----------------------------------------------------------------
# Cache time-to-live for a (query + pincode) result set, in seconds.
SEARCH_CACHE_TTL_SECONDS=300
# Per-provider request timeout, in milliseconds.
PROVIDER_TIMEOUT_MS=6000
# Rate limit for /api/search: requests per window, per client IP.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Demo-mode controls (development aid, ignored by live providers) --------
# Force listed providers to fail, to exercise partial-failure handling in the
# UI. Comma-separated provider ids, e.g. "zepto,flipkart".
DEMO_FAILING_PROVIDERS=
# Artificial latency range for demo providers, in milliseconds.
DEMO_MIN_LATENCY_MS=120
DEMO_MAX_LATENCY_MS=600
